{
  "$description": "Pintle design tokens (DTCG). Import with the 'Tokens Studio for Figma' plugin. Hex values are Figma-friendly approximations; the source of truth is OKLCH in packages/ui/src/styles/globals.css.",
  "radius": {
    "$type": "dimension",
    "base": { "$value": "8px", "$description": "--radius; sm/md/lg derive from this" }
  },
  "light": {
    "$type": "color",
    "background": { "$value": "#F2F5F4", "$description": "page paper, teal-biased" },
    "foreground": { "$value": "#101A19", "$description": "ink text" },
    "card": { "$value": "#FBFCFC" },
    "border": { "$value": "#DBE0DE" },
    "muted": { "$value": "#EDF1F0" },
    "mutedForeground": { "$value": "#647471", "$description": "slate secondary text" },
    "primary": { "$value": "#1B2B29", "$description": "ink buttons" },
    "primaryForeground": { "$value": "#F6F9F8" },
    "brand": {
      "$value": "#10A493",
      "$description": "signal-teal — focus, links, active, verified"
    },
    "brandForeground": { "$value": "#FBFEFD" },
    "success": { "$value": "#16B589" },
    "warning": { "$value": "#E0A63A" },
    "destructive": { "$value": "#D24B3E" }
  },
  "dark": {
    "$type": "color",
    "background": { "$value": "#0B1211", "$description": "deep teal-black" },
    "foreground": { "$value": "#E7ECEA" },
    "card": { "$value": "#111A19" },
    "border": { "$value": "#28322F" },
    "muted": { "$value": "#1B2523" },
    "mutedForeground": { "$value": "#9AAAA6" },
    "primary": { "$value": "#E7ECEA", "$description": "inverts light in dark mode" },
    "primaryForeground": { "$value": "#111A19" },
    "brand": { "$value": "#35D6BE", "$description": "brighter teal for dark grounds" },
    "brandForeground": { "$value": "#0E1918" },
    "success": { "$value": "#43D9B0" },
    "warning": { "$value": "#E7B24E" },
    "destructive": { "$value": "#E4695B" }
  }
}
