# Copy to .env and adjust. Defaults match infra/docker/docker-compose.yml.

NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://pintle:pintle@localhost:5432/pintle

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO, S3-compatible)
# Object storage. STORAGE_DRIVER selects where object bytes live:
#   s3         — any S3-compatible store (MinIO locally, AWS S3, R2, B2, GCS, Azure)
#   filesystem — plain local disk under STORAGE_FS_ROOT (single-box self-host;
#                note: presigned uploads are not supported on this driver yet)
STORAGE_DRIVER=s3
STORAGE_FS_ROOT=./.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pintle
S3_SECRET_ACCESS_KEY=pintle
S3_BUCKET=pintle
S3_FORCE_PATH_STYLE=true

# SMTP (Mailhog) — view sent mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Migration Tower <no-reply@migration-tower.dev>"

# API
API_PORT=4000
LOG_LEVEL=debug

# Auth (Clerk) — required for authenticated routes. Without it every
# authenticated request returns the AUTH_REQUIRED error envelope.
CLERK_SECRET_KEY=sk_test_replace_me

# OpenTelemetry (console exporter for now; set OTEL_SDK_DISABLED=true to skip)
OTEL_SERVICE_NAME=pintle-api
# OTEL_SDK_DISABLED=true
